# Host directory where the WhatsApp session, message database and downloaded
# media are persisted. Change this if you move the deployment to another
# machine or want the data stored somewhere else.
WHATSAPP_DATA_DIR=./data/whatsapp-store

# Host UID/GID to run the containers as, so files written to the bind mount
# above are owned by you instead of root. Run `id -u` / `id -g` if these
# don't match your user.
UID=1000
GID=1000

# Google Drive folder (ID from its URL) that scripts/run_media_pipeline.sh
# exports renamed attachments into. Leave unset to disable the export step.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
